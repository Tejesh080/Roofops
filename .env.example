# =============================================================================
# RoofOps environment variables: PLACEHOLDERS ONLY. Never commit real values.
# Real values live in .env / .env.local (both gitignored) or in n8n Credentials.
# There are NO mock providers: every integration is real, or it reports BLOCKED.
# Never prefix a secret with NEXT_PUBLIC_.
# =============================================================================

# --- Demo calendar -------------------------------------------------------------
DEMO_DATE=2026-09-29                 # business "today" for the synthetic dataset (also pinned in the DB via app_today())

# --- Local development database (Docker Postgres 17) ---------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/roofops
TEST_DATABASE_URL=                   # e.g. postgresql://postgres:postgres@127.0.0.1:54322/postgres (throwaway DB per test)

# --- Hosted Postgres (Supabase, live environment) ------------------------------
SUPABASE_DB_URL=                     # session pooler URI (IPv4): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_CA_CERT=                    # path to Supabase's root CA (dashboard > Database > SSL); enables full TLS verification
RUN_HOSTED_TESTS=                    # 1 = also run read-only / rolled-back verification suites against the hosted DB

# --- n8n Cloud (dedicated RoofOps workspace) -----------------------------------
N8N_BASE_URL=                        # https://<roofops-workspace>.app.n8n.cloud
N8N_API_KEY=                         # Settings > n8n API (paid plan required)

# --- DeepSeek (server-side only) -----------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Airtable (verification / read-back from tests; n8n uses its own credential) -
AIRTABLE_VERIFY_PAT=                 # scopes: data.records:read, schema.bases:read; RoofOps Demo base only

# Google Drive and Xero credentials live ONLY in n8n Credentials (OAuth2), never here.

# --- Phase 6: operations ---------------------------------------------------------
# Operator token for `npm run reconcile` (only its SHA-256 is stored, in app_settings.reconcile.trigger_token_sha256)
RECONCILE_TRIGGER_TOKEN=
# Operator token for `npm run reissue -- dispatch --hosted` (only its SHA-256 is stored, in app_settings.reissue.dispatch_token_sha256)
REISSUE_DISPATCH_TOKEN=
# Copilot regression target for `npm run ai:eval` (defaults to the local web app)
COPILOT_EVAL_URL=http://127.0.0.1:3000
