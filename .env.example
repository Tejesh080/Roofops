# =============================================================================
# RoofOps environment variables
# Copy to .env.local and fill in. Never commit real values.
# The app validates this file at startup (zod) and refuses to boot on bad config.
# With nothing but the defaults below, RoofOps runs fully in MOCK mode.
# =============================================================================

# --- Environment ---------------------------------------------------------------
APP_ENV=local                        # local | preview | demo
DEMO_MODE=true                       # shows SYNTHETIC DEMO DATA banner + role switcher
DEMO_DATE=2026-09-29                 # business "today" for the synthetic dataset (also pinned in the DB via app_today())

# --- Database (Supabase) ------------------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/roofops
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Workflow runner ----------------------------------------------------------
WORKFLOW_RUNNER=local                # local | n8n
AUTOMATION_PAUSED=false              # kill switch: queue inbound events, dispatch nothing
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=                     # n8n webhook that receives RoofOps events
ROOFOPS_WEBHOOK_SIGNING_SECRET=      # HMAC secret for n8n <-> RoofOps (both directions)
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# --- Reliability --------------------------------------------------------------
RETRY_BASE_MS=1000
RETRY_CAP_MS=60000
RETRY_MAX_ATTEMPTS=5
RETRY_TIME_SCALE=1                   # demo only: 0.05 compresses real waits 20x (UI shows nominal delays)
IDEMPOTENCY_LEASE_SECONDS=30
DEMO_FAULT_INJECTION=false           # enables Reliability Lab controls; refuses to wrap REAL providers

# --- AI provider --------------------------------------------------------------
LLM_PROVIDER=mock                    # mock | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ACTIONS_ENABLED=true              # false hides AMBER/RED tools entirely
AI_TOOL_RESULT_ROW_CAP=50

# --- Xero (Accounting API) ----------------------------------------------------
MOCK_XERO=true
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback
XERO_SCOPES=                         # set from current Xero docs in Phase 6 (granular scopes)
XERO_TENANT_ID=                      # Demo Company tenant, captured after OAuth connect
XERO_WEBHOOK_KEY=

# --- Google Workspace (Drive / Gmail) -----------------------------------------
MOCK_GOOGLE_DRIVE=true
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=  # PEM, \n-escaped
GOOGLE_DRIVE_PROJECTS_PARENT_FOLDER_ID=
MOCK_NOTIFICATIONS=true
NOTIFY_FROM_ADDRESS=roofops-demo@example.com

# --- Airtable (downstream mirror) ---------------------------------------------
MOCK_AIRTABLE=true
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_PROJECTS_TABLE_ID=
AIRTABLE_PURCHASE_ORDERS_TABLE_ID=

# --- Tests --------------------------------------------------------------------
RUN_REAL_INTEGRATION_TESTS=false     # opt-in: run adapter contract tests against REAL providers
TEST_DATABASE_URL=                   # e.g. postgresql://postgres:postgres@127.0.0.1:54322/postgres : also run DB suites on real Postgres (a throwaway DB per test)
