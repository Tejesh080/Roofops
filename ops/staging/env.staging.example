# Copy to ops/staging/.env.staging (gitignored). The STAGING Supabase project only: never the production one.
# The owner (postgres) connection through the pooler, as Supabase shows it for the NEW project.
STAGING_DB_URL=postgresql://postgres.<staging-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: Supabase's CA certificate for verified TLS (Project Settings > Database > SSL).
# STAGING_CA_CERT=ops/staging/secrets/staging-ca.crt
