{
  "name": "roofops",
  "version": "0.1.0",
  "private": true,
  "description": "RoofOps: operations and automation platform for a fictional Australian roofing contractor (synthetic demo data).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:normalise": "tsx scripts/normalise-dates.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:load": "tsx scripts/db-load.ts",
    "db:reset": "tsx scripts/db-load.ts --reset",
    "check": "npm run lint && npm run typecheck && npm run typecheck:web && npm test",
    "data:check": "tsx scripts/normalise-dates.ts --check",
    "db:provision-n8n": "tsx scripts/provision-n8n-role.ts",
    "demo:status": "tsx scripts/demo.ts status",
    "demo:reset": "tsx scripts/demo.ts reset",
    "exception:resolve": "tsx scripts/exception.ts resolve",
    "reissue": "tsx scripts/reissue.ts",
    "integrity:check": "tsx scripts/integrity-check.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "contract:export": "tsx scripts/export-contract.ts",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "security:check": "tsx scripts/security-check.ts",
    "typecheck:web": "npm --prefix web run typecheck",
    "staff:set-password": "tsx scripts/staff.ts set-password"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "csv-parse": "^7.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
