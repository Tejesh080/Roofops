# RoofOps dashboard (server-side only). PLACEHOLDERS ONLY. Real values: web/.env.local (gitignored),
# written by `npx tsx scripts/provision-dashboard-role.ts`. Never prefix any of these with NEXT_PUBLIC_.
DASHBOARD_DATABASE_URL=     # roofops_web login (member of roofops_dashboard): reads dashboard views, can request an invoice preview, nothing else
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
