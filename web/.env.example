# =============================================================================
# RoofOps Operations dashboard (web/). PLACEHOLDERS ONLY: never commit real values.
# Local: web/.env.local (gitignored), written by `npx tsx scripts/provision-dashboard-role.ts`.
# Vercel: Project → Settings → Environment Variables (Production), all "Sensitive".
# Every value is server-side only. Never prefix any of these with NEXT_PUBLIC_.
# =============================================================================

# --- Database: the least-privilege roofops_web login (reads dashboard views, can request an invoice preview; nothing else)
DASHBOARD_DATABASE_URL=postgresql://roofops_web.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DASHBOARD_DB_POOL_MAX=4                # use 1 on Vercel (one connection per serverless instance)
# REQUIRED for any non-local database: the Supabase root CA, so the server certificate is verified. Without one of
# these the dashboard refuses to connect (it never uses an unverified TLS connection). Local 127.0.0.1 needs neither.
DASHBOARD_DB_CA_PEM=                   # the CA as PEM text, \n-escaped (Vercel)
DASHBOARD_DB_CA_CERT=                  # or: an ABSOLUTE path to the CA file (local machine), e.g. D:/Claude/roofops/secrets/prod-ca-2021.crt. PEM wins if both are set

# --- DeepSeek (Operations Copilot)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Interview-demo sign-in (fails closed if any is missing or too short)
DEMO_USERNAME=                         # e.g. a first name
DEMO_PASSWORD=                         # at least 12 characters, random
AUTH_SECRET=                           # at least 32 random characters: signs the session cookie (openssl rand -base64 48)

# Not needed by the dashboard, and must NOT be set here: n8n API key, Airtable tokens, Xero or Google tokens,
# the database owner URL. Those stay in n8n Credentials or the operator's machine.
